+def format_syntax_error(message: str, *, source: str, span: tuple[int, int]) -> str:
+    """Render a syntax error message together with an excerpt of the source.
+
+    The excerpt is followed by a marker underlining the offending text, e.g.::
+
+        Expected package name at the start of dependency specifier
+            ==0.0
+            ^
+    """
+    marker = " " * span[0] + "~" * (span[1] - span[0]) + "^"
+    return f"{message}\n    {source}\n    {marker}"
 
 
