+def _format_syntax_error(message: str, source: str, span: tuple[int, int]) -> str:
+    """Render an error message with the offending source and a span marker."""
+    marker = " " * span[0] + "~" * (span[1] - span[0]) + "^"
+    return f"{message}\n    {source}\n    {marker}"
+
+
+class _DetailedSyntaxError(ValueError):
+    """Base class for errors that expose details of a failed parse.
+
+    :attr:`message`, :attr:`source`, and :attr:`span` mirror the attributes of
+    :class:`ParserSyntaxError`, so they can be inspected on the public errors
+    without reaching for ``__cause__``. ``source`` and ``span`` are ``None``
+    when the error does not come from parsing text, for example when a
+    requirement's specifier is rejected while being interpreted.
+    """
+
+    def __init__(
+        self,
+        message: str,
+        *,
+        source: str | None = None,
+        span: tuple[int, int] | None = None,
+    ) -> None:
+        self.message = message
+        self.source = source
+        self.span = span
+
+        super().__init__(message)
+
+    def __str__(self) -> str:
+        if self.source is None or self.span is None:
+            return self.message
+        return _format_syntax_error(self.message, self.source, self.span)
 
 
